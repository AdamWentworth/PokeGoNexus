{
  "name": "pokego-nexus-web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "immer": "^11.1.4",
    "lodash": "^4.18.1",
    "ol": "^10.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.5.0",
    "react-router": "8.3.0",
    "uuid": "^14.0.0",
    "web-vitals": "^5.2.0",
    "zustand": "^5.0.11"
  },
  "scripts": {
    "check:shared-contracts": "node scripts/verify-shared-contracts.mjs",
    "audit:game-master": "node scripts/audit-game-master.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:budget": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "test": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --config ../../apps/web/vite.config.mjs",
    "test:coverage": "cd ../../packages/app-core && cross-env VITEST_LOW_MEMORY=1 NODE_OPTIONS=--max-old-space-size=6144 vitest run --config ../../apps/web/vite.config.mjs --coverage",
    "test:silent": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest --config ../../apps/web/vite.config.mjs --silent",
    "test:watch": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest --config ../../apps/web/vite.config.mjs watch",
    "test:ui": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest --config ../../apps/web/vite.config.mjs --ui",
    "test:unit": "npm run test:unit:batched",
    "test:unit:batched": "node scripts/run-unit-tests-batched.mjs",
    "test:unit:single-process": "cd ../../packages/app-core && cross-env VITEST_LOW_MEMORY=1 NODE_OPTIONS=--max-old-space-size=4096 vitest run --config ../../apps/web/vite.config.mjs tests/unit",
    "test:unit:parallel": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 VITEST_ALLOW_PARALLEL=1 vitest run --config ../../apps/web/vite.config.mjs tests/unit",
    "test:integration": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --config ../../apps/web/vite.config.mjs tests/integration",
    "test:raid-model": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --config ../../apps/web/vite.config.mjs tests/unit/pages/Raid/utils/raidRankingValidation.unit.test.ts",
    "test:raid-model:live": "cd ../../packages/app-core && cross-env RUN_LIVE_RAID_CATALOG_VALIDATION=1 NODE_OPTIONS=--max-old-space-size=4096 vitest run --config ../../apps/web/vite.config.mjs tests/integration/pages/Raid/raidLiveCatalog.integration.test.ts",
    "test:contracts": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --config ../../apps/web/vite.config.mjs tests/contracts",
    "test:e2e": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --config ../../apps/web/vite.config.mjs tests/e2e",
    "test:variants": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --config ../../apps/web/vite.config.mjs tests/unit/features/variants tests/integration/features/variants tests/contracts/pokemonDataService.contract.test.ts",
    "test:instances": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --config ../../apps/web/vite.config.mjs tests/unit/features/instances tests/integration/features/instances",
    "test:tags": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --config ../../apps/web/vite.config.mjs tests/unit/features/tags tests/integration/features/tags",
    "test:file": "cd ../../packages/app-core && cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --config ../../apps/web/vite.config.mjs",
    "test:browsers": "npm run test:browsers:functional && npm run test:browsers:performance",
    "test:browsers:functional": "node scripts/run-playwright-clean-env.mjs test --grep-invert @performance --workers 2",
    "test:browsers:performance": "node scripts/run-playwright-clean-env.mjs test --grep @performance --project chromium-desktop --workers 1",
    "performance:parity:report": "node scripts/run-playwright-clean-env.mjs test tests/browser/performance-parity-report.spec.ts --project mobile-chrome --workers 1 --reporter=list",
    "performance:parity:report:android": "cross-env POKEGONEXUS_PERFORMANCE_PROFILE=physical-android node scripts/run-playwright-clean-env.mjs test tests/browser/performance-parity-report.spec.ts --project mobile-chrome --workers 1 --reporter=list",
    "test:browsers:ci": "node scripts/run-playwright-clean-env.mjs test --reporter=list",
    "test:browsers:safari": "node scripts/run-playwright-clean-env.mjs test --project=webkit-desktop --project=mobile-safari --workers=2",
    "test:browsers:headed": "node scripts/run-playwright-clean-env.mjs test --headed",
    "test:browsers:debug": "node scripts/run-playwright-clean-env.mjs test --debug",
    "test:browsers:report": "playwright show-report .artifacts/browser/html-report",
    "smoke:production": "node scripts/smoke-production.mjs",
    "capture:demo": "cross-env DEMO_CAPTURE=1 E2E_PORT=3010 E2E_FAIL_ON_CONSOLE=0 node scripts/run-playwright-clean-env.mjs test tests/browser/demo-capture.spec.ts --project=chromium-desktop --reporter=list",
    "capture:demo:live": "node scripts/run-live-demo-capture.mjs",
    "capture:demo:video:live": "node scripts/run-live-demo-video-capture.mjs",
    "capture:demo:auth:live": "node scripts/run-live-demo-auth-capture.mjs",
    "capture:demo:workflows:live": "node scripts/run-live-demo-workflow-capture.mjs",
    "capture:demo:posters:live": "node scripts/run-live-demo-video-poster-capture.mjs",
    "capture:demo:media:live": "node scripts/run-live-demo-all-media-capture.mjs",
    "install:browsers": "playwright install chromium firefox webkit",
    "install:browsers:deps": "playwright install --with-deps chromium firefox webkit",
    "lint": "cd ../../packages/app-core && eslint src --ext .ts,.tsx --config eslint.config.mjs",
    "lint:styles": "cd ../../packages/app-core && stylelint \"src/**/*.css\" --config ../../apps/web/.stylelintrc.json --ignore-path ../../apps/web/.stylelintignore",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "lint:fix": "cd ../../packages/app-core && eslint src --ext .ts,.tsx --fix --config eslint.config.mjs",
    "capture:demo:branch": "tsc --project tsconfig.capture.json && node scripts/run-branch-media-capture.mjs",
    "capture:demo:account:login": "node scripts/sign-in-account-media.mjs",
    "capture:demo:account": "node scripts/run-account-media-capture.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "6.2.5",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.6.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.12.10",
    "pngjs": "^3.4.0",
    "stylelint": "^17.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.5",
    "web-streams-polyfill": "^4.2.0"
  }
}
