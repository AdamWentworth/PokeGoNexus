{
  "name": "frontend-workspace",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "performance:parity:test": "node --test scripts/performance-parity/*.test.mjs",
    "performance:parity:compare": "node scripts/performance-parity/compare.mjs",
    "performance:parity:browser": "node scripts/performance-parity/run-browser-proxy.mjs",
    "performance:parity:android": "node scripts/performance-parity/run-physical-android.mjs",
    "test": "npm run test:web && npm run test:mobile",
    "test:web": "npm --workspace apps/web run test",
    "test:browsers:web": "npm --workspace apps/web run test:browsers",
    "test:mobile": "npm --workspace apps/mobile run test",
    "lint": "npm run lint:web && npm run lint:mobile",
    "lint:dead-code": "knip --include files",
    "lint:web": "npm --workspace apps/web run lint && npm --workspace apps/web run lint:styles",
    "lint:mobile": "npm --workspace apps/mobile run lint",
    "typecheck": "npm run typecheck:web && npm run typecheck:mobile",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "typecheck:mobile": "npm --workspace apps/mobile run typecheck"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "expo-modules-core": "~57.0.18",
    "knip": "^6.32.2",
    "patch-package": "^8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-router": "8.3.0"
  },
  "overrides": {
    "@babel/helpers": "^7.28.6",
    "@babel/runtime": "^7.28.6",
    "@eslint/plugin-kit": "^0.6.0",
    "@tootallnate/once": "3.0.1",
    "@expo/cli": {
      "ws": "8.21.0"
    },
    "cookie": "^1.1.1",
    "fast-uri": "3.1.7",
    "form-data": "^4.0.6",
    "jsdom": {
      "undici": "7.29.0",
      "ws": "8.21.0"
    },
    "js-yaml": "^4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "nanoid": "^3.3.18",
    "postcss": "8.5.23",
    "postcss-selector-parser@>=7.1.0 <7.1.3": "7.1.3",
    "react-native-reanimated": "$react-native-reanimated",
    "react-native-worklets": "$react-native-worklets",
    "shell-quote": "^1.9.0",
    "tar": "7.5.11",
    "tmp": "^0.2.5",
    "undici": "7.29.0",
    "ws": "8.21.0"
  }
}
